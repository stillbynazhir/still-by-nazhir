# Copy this file to .env.local and fill in real values.

# SMTP (contact form, sent via Nodemailer)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where inquiry notifications land. Defaults to SMTP_USER if unset.
CONTACT_TO_EMAIL=

# Cloudflare Worker that lists gallery photos from R2
NEXT_PUBLIC_GALLERY_WORKER_URL=
